{
    "name": "@diary/api",
    "version": "2.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "bun --env-file=../../.env --watch src/index.ts",
        "start": "bun dist/index.js",
        "build": "bun build src/index.ts --target bun --outdir dist",
        "check": "tsc --project tsconfig.json",
        "test": "bun test --pass-with-no-tests",
        "db:generate": "bun --filter @diary/database db:generate",
        "db:migrate": "bun --filter @diary/database db:migrate",
        "db:studio": "bun --filter @diary/database db:studio"
    },
    "dependencies": {
        "@clerk/backend": "3.13.1",
        "@diary/contracts": "workspace:*",
        "@diary/database": "workspace:*",
        "@elysia/cors": "1.4.2",
        "@elysia/openapi": "1.4.15",
        "drizzle-orm": "0.45.2",
        "elysia": "1.4.29",
        "stripe": "22.3.2",
        "zod": "4.4.3"
    },
    "devDependencies": {
        "@types/bun": "1.3.14",
        "typescript": "7.0.2"
    }
}
