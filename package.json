{
    "name": "diary",
    "private": true,
    "packageManager": "bun@1.3.14",
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "dev": "turbo dev",
        "dev:web": "bun --filter @diary/web dev",
        "dev:api": "bun --filter @diary/api dev",
        "build": "turbo build",
        "check": "turbo check",
        "test": "turbo test",
        "format": "biome format --write .",
        "lint": "biome lint ."
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.5",
        "turbo": "2.10.7",
        "typescript": "7.0.2"
    }
}
