# Published ports
WEB_PORT=3000
API_PORT=8080
POSTGRES_PORT=5432

# PostgreSQL
POSTGRES_DB=diary
POSTGRES_USER=diary
POSTGRES_PASSWORD=replace_with_a_strong_local_password
DB_URL=postgresql://diary:replace_with_a_strong_local_password@localhost:5432/diary

# Browser-visible web configuration
VITE_API_URL=http://localhost:8080
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# Server URLs
WEB_URL=http://localhost:3000

# Clerk
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
CLERK_WEBHOOK_SIGNING_SECRET=whsec_replace_me
# Optional networkless token verification:
# CLERK_JWT_KEY=-----BEGIN PUBLIC KEY-----...
# CLERK_AUTHORIZED_PARTIES=http://localhost:3000,https://diary.kyle.so

# Entry encryption
ENCRYPTION_KEY=replace_with_a_long_random_secret

# Stripe
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_FREE_PRICE_ID=price_replace_me
STRIPE_PLUS_PRICE_ID=price_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
