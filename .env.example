# Published ports
WEB_PORT=3000
API_PORT=8080
POSTGRES_PORT=5432

# PostgreSQL
POSTGRES_DB=diary
POSTGRES_USER=diary
POSTGRES_PASSWORD=replace_with_a_strong_local_password
DB_URL=postgresql://diary:replace_with_a_strong_local_password@localhost:5432/diary

# Browser-visible web configuration
VITE_API_URL=http://localhost:8080

# Server URLs
WEB_URL=http://localhost:3000
API_URL=http://localhost:8080

# Better Auth and Resend
BETTER_AUTH_SECRET=replace_with_at_least_32_random_characters
RESEND_API_KEY=re_replace_me
AUTH_EMAIL_FROM=Diary <auth@mail.kyle.so>

# Entry encryption
ENCRYPTION_KEY=replace_with_a_long_random_secret

# Stripe
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PLUS_PRICE_ID=price_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
